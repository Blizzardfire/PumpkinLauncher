<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pumpkin_black"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="@color/pumpkin_black"
            android:background="@drawable/sticky_orange"
            app:backgroundTint="@null"
            android:fontFamily="@font/sora" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Worlds"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/sora" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/worldsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/newWorldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="+ New World"
        android:textColor="@color/pumpkin_black"
        android:textStyle="bold"
        android:background="@drawable/sticky_green"
        app:backgroundTint="@null"
        android:fontFamily="@font/sora" />

    <Button
        android:id="@+id/importWorldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Import World — Coming Soon"
        android:textColor="@color/pumpkin_black"
        android:textStyle="bold"
        android:alpha="0.5"
        android:background="@drawable/sticky_blue"
        app:backgroundTint="@null"
        android:fontFamily="@font/sora" />

</LinearLayout>