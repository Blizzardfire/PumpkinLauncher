<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pumpkin_black"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="@color/pumpkin_black"
            android:background="@drawable/sticky_orange"
            app:backgroundTint="@null"
            android:fontFamily="@font/sora" />

        <TextView
            android:id="@+id/configTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Server Settings"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/sora" />

        <Button
            android:id="@+id/saveConfigButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="@color/pumpkin_black"
            android:background="@drawable/sticky_green"
            app:backgroundTint="@null"
            android:fontFamily="@font/sora" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/terminal_bg">

        <EditText
            android:id="@+id/configEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="@color/console_green"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:padding="10dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="20" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Restart the server for changes to take effect."
        android:textColor="#888888"
        android:textSize="12sp"
        android:paddingTop="8dp"
        android:fontFamily="@font/sora" />

</LinearLayout>